<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_Login"
    android:padding="28dp">

    <!-- AVATAR -->
    <ImageView
        android:id="@+id/avatar"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="50dp"
        android:src="@drawable/usuario"
        android:contentDescription="Avatar"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CAMPO USUARIO -->
    <LinearLayout
        android:id="@+id/campoUsuario"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginTop="45dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginHorizontal="12dp"
            android:src="@drawable/email"
            android:contentDescription="Usuario"
            app:tint="#FFFFFF" />

        <EditText
            android:id="@+id/etUsuario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:gravity="center"
            android:hint="Username"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#EEEEEE"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- CAMPO CONTRASEÑA -->
    <LinearLayout
        android:id="@+id/campoPassword"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/campoUsuario"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginHorizontal="12dp"
            android:src="@drawable/password"
            android:contentDescription="Contraseña"
            app:tint="#FFFFFF" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:gravity="center"
            android:hint="Password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#EEEEEE"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- RECORDAR USUARIO -->
    <CheckBox
        android:id="@+id/checkRecordar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:buttonTint="#FFFFFF"
        android:checked="true"
        android:text="Remember me"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/campoPassword"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- OLVIDÉ CONTRASEÑA -->
    <TextView
        android:id="@+id/tvOlvidar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forgot password?"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="@id/checkRecordar"
        app:layout_constraintBottom_toBottomOf="@id/checkRecordar"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BOTÓN LOGIN -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/boton_login"
        android:backgroundTint="@null"
        android:text="Sign In"
        android:textAllCaps="false"
        android:textColor="#8277A0"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/checkRecordar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TEXTO INFERIOR -->
    <TextView
        android:id="@+id/tvNoMiembro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Not a member?"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/btnRegistro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CREAR CUENTA -->
    <TextView
        android:id="@+id/btnRegistro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp"
        android:background="@drawable/boton_login"
        android:backgroundTint="@null"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:text="Create account"
        android:textColor="#8277A0"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
